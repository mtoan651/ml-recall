{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "description": "A citation supporting the question or explanation, referenced as [^n] (1-based).",
      "properties": {
        "source": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id in src/content/sources.yaml",
          "title": "Source"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For works not in the registry (e.g. a paper)",
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chapter/section/page/slide, e.g. 'Sec. 4.3'",
          "title": "Locator"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short verbatim excerpt (keep it brief).",
          "title": "Quote"
        }
      },
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Front matter of a topic note: src/content/notes/<domain>/<topic>.md (body: Markdown).",
  "properties": {
    "topic": {
      "description": "Topic id from taxonomy.yaml; one note per topic",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Topic",
      "type": "string"
    },
    "summary": {
      "description": "One sentence on what the topic is about (shown under the title)",
      "maxLength": 200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewed_by": {
      "anyOf": [
        {
          "enum": [
            "owner",
            "claude"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required when reviewed: the owner, or Claude at the owner's request",
      "title": "Reviewed By"
    },
    "references": {
      "description": "Cited in the body as [^1], [^2], \u2026 (1-based)",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 2,
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "topic",
    "summary",
    "references"
  ],
  "title": "Note",
  "type": "object"
}
