---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { url } from "../lib/url";

interface Props {
  /** Page title; the site name is appended. */
  title?: string;
  description?: string;
  /** Wider container for overview pages. */
  wide?: boolean;
}

const SITE = "ml-recall";
const DEFAULT_DESCRIPTION =
  "Active-recall quiz bank for AI/ML/DL: exam-style questions with LaTeX and cited explanations.";
const { title, description = DEFAULT_DESCRIPTION, wide = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : `${SITE} — active recall for AI/ML/DL`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const container = wide ? "max-w-5xl" : "max-w-3xl";
const repo = "https://github.com/mtoan651/ml-recall";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <noscript><style>.quiz-stage { opacity: 1 !important; }</style></noscript>
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <header class="border-b border-line bg-surface/80 backdrop-blur supports-[backdrop-filter]:bg-surface/70">
      <div class:list={["mx-auto flex items-center justify-between gap-4 px-4 py-3 sm:px-6", container]}>
        <a href={url()} class="flex items-center gap-2 font-semibold tracking-tight text-ink">
          <svg aria-hidden="true" viewBox="0 0 32 32" class="size-6">
            <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
            <path d="M9 21.5 14 11l4 7.5 2.5-4L24 21.5" fill="none" stroke="var(--accent-ink)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>ml-recall</span>
        </a>
        <nav aria-label="Main" class="flex items-center gap-4 text-sm text-muted">
          <a href={url()} class="hover:text-ink">Topics</a>
          <a href={url("tags/")} class="hover:text-ink">Tags</a>
          <a href={repo} class="hover:text-ink" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main" class:list={["mx-auto px-4 pt-6 pb-16 sm:px-6 sm:pt-10", container]}>
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-muted">
      <div class:list={["mx-auto space-y-1 px-4 py-6 sm:px-6", container]}>
        <p>
          Code <a class="underline underline-offset-2 hover:text-ink" href={`${repo}/blob/main/LICENSE`}>MIT</a>.
          Questions keep their source's license (shown under each answer); original questions
          <a class="underline underline-offset-2 hover:text-ink" href={`${repo}/blob/main/LICENSE-CONTENT.md`}>CC BY-SA 4.0</a>.
        </p>
        <p>Progress is stored only in this browser.</p>
      </div>
    </footer>
  </body>
</html>
