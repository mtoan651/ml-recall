---
/**
 * A topic or domain title: English as rendered, "Vietnamese · English" in the Vietnamese
 * interface (src/lib/i18n-dom.ts, titles in src/lib/i18n-titles.ts).
 */
interface Props {
  topic?: string;
  domain?: string;
  /** The English title. */
  en: string;
}

const { topic, domain, en } = Astro.props;
---

<span data-i18n-topic={topic} data-i18n-domain={domain}>{en}</span>
