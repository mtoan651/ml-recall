---
/**
 * Translatable text in Astro markup: renders the English text in a span that the page script
 * translates (src/lib/i18n-dom.ts). `k` is the key (the English text with `{name}` placeholders);
 * with `n`, `one` is used when n is 1 and `{n}` is filled in. Keys must be string literals (the
 * key check in src/lib/i18n.test.ts reads `k="…"` and `one="…"`).
 */
import { type Params, t } from "../lib/i18n";

interface Props {
  k: string;
  /** Singular key, used when `n` is 1. */
  one?: string;
  n?: number;
  params?: Params;
}

const { k, one, n, params } = Astro.props;
const key = n === 1 && one !== undefined ? one : k;
const all: Params | undefined = n === undefined ? params : { n, ...params };
---

<span data-i18n={key} data-i18n-params={all ? JSON.stringify(all) : undefined}>{t("en", key, all)}</span>
