---
/**
 * "Take a test" call-to-action on topic and tag pages. Size and time are known at build time;
 * the last / best score and a test in progress are filled in from localStorage.
 */
import { examScope, planExam, type ScopeKind } from "../lib/exam";
import { ClockIcon } from "./Icons";
import T from "./T.astro";

interface Props {
  kind: ScopeKind;
  id: string;
  /** URL of the test page. */
  href: string;
  /** Questions that can be in a test. */
  available: number;
}

const { kind, id, href, available } = Astro.props;
const { count } = planExam(available);
---

{
  count > 0 && (
    <section
      aria-labelledby="exam-callout-heading"
      class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 rounded-2xl border border-line bg-surface px-4 py-3.5 shadow-xs sm:px-5"
      data-exam-callout
      data-scope={examScope(kind, id)}
    >
      <div class="min-w-0 flex-1 basis-56">
        <h2 id="exam-callout-heading" class="flex items-center gap-2 font-semibold">
          <ClockIcon className="size-5 shrink-0 text-accent" />
          <T k="Timed test" />
        </h2>
        <p class="mt-0.5 text-sm text-muted tabular-nums">
          <T
            k="{n} questions · {n} min · score and explanations at the end"
            one="{n} question · {n} min · score and explanations at the end"
            n={count}
          />
        </p>
        <p class="mt-1 hidden text-sm tabular-nums" data-exam-status />
        <slot />
      </div>
      <a
        href={href}
        class="shrink-0 rounded-lg bg-accent px-4 py-2 font-medium text-accent-ink hover:bg-accent-hover"
        data-exam-link
      >
        <T k="Take a test" />
      </a>
    </section>
  )
}

<script>
  import { describeAttempt, lastAttempt } from "../lib/exam";
  import { currentLang, LANG_EVENT, t } from "../lib/i18n";
  import { examTimeLeft, loadExamHistory } from "../lib/storage";

  /** "Resume test" while a test runs, otherwise the last and best score, if any. */
  function update(el: HTMLElement) {
    const scope = el.dataset.scope ?? "";
    const status = el.querySelector<HTMLElement>("[data-exam-status]");
    const link = el.querySelector<HTMLElement>("[data-exam-link]");
    if (!status || !link) return;
    const lang = currentLang();
    status.classList.remove("font-medium", "text-note", "text-muted");

    const left = examTimeLeft(scope);
    if (left !== null) {
      link.textContent = t(lang, "Resume test");
      status.textContent = t(lang, "Test in progress · {n} min left", {
        n: Math.ceil(left / 60_000),
      });
      status.classList.add("font-medium", "text-note");
      status.classList.remove("hidden");
      return;
    }

    link.textContent = t(lang, "Take a test");
    const history = loadExamHistory(scope);
    const last = lastAttempt(history);
    const best = history.best;
    status.textContent = !last
      ? ""
      : best
        ? t(lang, "Last {last} · Best {best}", {
            last: describeAttempt(last),
            best: describeAttempt(best),
          })
        : t(lang, "Last {last}", { last: describeAttempt(last) });
    status.classList.add("text-muted");
    status.classList.toggle("hidden", !last);
  }

  const updateAll = () => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-exam-callout]")) update(el);
  };
  updateAll();
  window.addEventListener(LANG_EVENT, updateAll);
  // Coming back with the Back button restores the page from cache: refresh what it shows.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) updateAll();
  });
</script>
