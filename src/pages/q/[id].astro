---
/**
 * One question on its own page, `/q/<id>/`: shareable, answerable (the practice quiz with one
 * question) and the unit of the search index — `data-pagefind-body` marks what Pagefind indexes
 * (see docs/web-app.md#search), with the topic, domain, type and difficulty as filters.
 */
import Quiz from "../../components/Quiz";
import Base from "../../layouts/Base.astro";
import { type BankQuestion, getBank, toQuizQuestion } from "../../lib/bank";
import { getNotes } from "../../lib/notes";
import { plainText } from "../../lib/text";
import { tagUrl, url } from "../../lib/url";

export async function getStaticPaths() {
  const bank = await getBank();
  return bank.questions.map((bq) => ({ params: { id: bq.question.id }, props: { bq } }));
}

const TYPE_LABEL = {
  single: "Single choice",
  multiple: "Multiple choice",
  true_false: "True / false",
  short_answer: "Short answer",
} as const;

const { bq } = Astro.props as { bq: BankQuestion };
const bank = await getBank();
const question = await toQuizQuestion(bq, bank);
const q = bq.question;
const title = plainText(q.question, 90);
const note = (await getNotes(bank)).get(bq.topic.id);
---

<Base title={title} description={`${bq.topic.title}: ${plainText(q.question, 150)}`}>
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink">Topics</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <span>{bq.topic.domainTitle}</span>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={bq.topic.url} class="hover:text-ink">{bq.topic.title}</a>
  </nav>
  <h1 class="mt-2 text-lg font-semibold tracking-tight text-muted">
    Question <span class="font-mono text-base">{q.id}</span>
  </h1>

  <article class="mt-4" data-pagefind-body>
    {/* Ignored as text (default "index" mode) but still read as the result title. */}
    <span hidden data-pagefind-ignore data-pagefind-meta="title">{title}</span>
    {/* Filter values as attributes, so they are not indexed as text (titles have no `,` or `:`). */}
    <span data-pagefind-filter={`Domain:${bq.topic.domainTitle}`}></span>
    <span data-pagefind-filter={`Topic:${bq.topic.title}`}></span>
    <span data-pagefind-filter={`Type:${TYPE_LABEL[q.type]}`}></span>
    {q.difficulty && <span data-pagefind-filter={`Difficulty:${q.difficulty}`}></span>}
    <Quiz client:load questions={[question]} scope={q.id} />
  </article>

  <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
    <a href={bq.topic.url} class="font-medium text-accent hover:underline">
      Practice all of {bq.topic.title}
    </a>
    {
      note && (
        <a href={`${bq.topic.url}notes/`} class="font-medium text-accent hover:underline">
          Notes on {bq.topic.title}
        </a>
      )
    }
    {
      q.tags.map((tag) => (
        <a href={tagUrl(tag)} class="rounded-md bg-subtle px-1.5 py-0.5 hover:text-ink">
          #{tag}
        </a>
      ))
    }
  </p>
</Base>
