---
import Progress from "../components/Progress";
import Base from "../layouts/Base.astro";
import { getBank, toCatalog } from "../lib/bank";

const catalog = toCatalog(await getBank());
---

<Base
  title="Progress"
  description="Your answered and correct questions and your test scores per topic, from this browser."
  wide
>
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Progress</h1>
  <p class="mt-2 text-muted">From the results stored in this browser.</p>
  <noscript>
    <p class="mt-4 text-muted">This page needs JavaScript.</p>
  </noscript>
  <div class="mt-6">
    <Progress client:load catalog={catalog} />
  </div>
</Base>
