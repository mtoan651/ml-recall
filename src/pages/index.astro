---
import I18nTitle from "../components/I18nTitle.astro";
import T from "../components/T.astro";
import Base from "../layouts/Base.astro";
import { getBank } from "../lib/bank";
import { planExam } from "../lib/exam";
import { mistakesUrl, mixedExamUrl, progressUrl, reviewUrl, topicExamUrl, url } from "../lib/url";

const bank = await getBank();
const totalQuestions = bank.questions.length;
const totalReviewed = bank.questions.filter((q) => q.question.status === "reviewed").length;
const activeTopics = [...bank.topics.values()].filter((t) => t.questionIds.length > 0).length;
/** Topic id → questions in its timed test (0: no test page). */
const testSize = new Map(
  [...bank.topics.keys()].map((id) => [
    id,
    planExam(bank.questions.filter((q) => q.topic.id === id).length).count,
  ]),
);
---

<Base wide>
  <section class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      <T k="Practice AI, ML and deep learning by recalling, not rereading." />
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      <T k="Exam-style questions with instant feedback, worked explanations and cited sources. Pick a topic and answer one question at a time, or take a timed test — your last result per question stays in this browser." />
    </p>
    <p class="mt-4 text-sm text-muted">
      <T
        k="{questions} questions · {topics} topics · {reviewed} reviewed"
        params={{ questions: totalQuestions, topics: activeTopics, reviewed: totalReviewed }}
      /> ·
      <a href={url("tags/")} class="text-accent underline underline-offset-2"><T k="browse by tag" /></a> ·
      <a href={url("glossary/")} class="text-accent underline underline-offset-2"><T k="EN–VI glossary" /></a>
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      <a href={reviewUrl()} class="inline-flex items-center gap-1.5 rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle">
        <T k="Review" /><span data-due-badge hidden class="rounded-full bg-accent px-1.5 text-xs leading-5 font-semibold text-accent-ink tabular-nums"></span>
      </a>
      <a href={mixedExamUrl()} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:bg-accent-hover">
        <T k="Mixed test across topics" />
      </a>
      <a href={url("ce6146/")} class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle">
        <T k="CE6146 exam prep" />
      </a>
      <a href={mistakesUrl()} class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle">
        <T k="My mistakes" />
      </a>
      <a href={progressUrl()} class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle">
        <T k="Progress" />
      </a>
    </div>
  </section>

  <div class="mt-10 space-y-10">
    {
      bank.domains.map((domain) => (
        <section aria-labelledby={`domain-${domain.id}`}>
          <h2 id={`domain-${domain.id}`} class="text-sm font-semibold tracking-wide text-muted uppercase">
            <I18nTitle domain={domain.id} en={domain.title} />
          </h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {domain.topics.map((topic) => {
              const total = topic.questionIds.length;
              const title = { topic: topic.id, en: topic.title };
              if (total === 0) {
                return (
                  <li class="rounded-xl border border-dashed border-line px-4 py-3 text-muted">
                    <span class="font-medium"><I18nTitle topic={topic.id} en={topic.title} /></span>
                    <span class="mt-1 block text-sm"><T k="No questions yet" /></span>
                  </li>
                );
              }
              const test = testSize.get(topic.id) ?? 0;
              // The whole card links to the topic (stretched ::after); the test link sits above it.
              return (
                <li class="group relative h-full rounded-xl border border-line bg-surface px-4 py-3 shadow-xs transition-colors hover:border-line-strong hover:bg-subtle has-[.card-link:focus-visible]:outline-2 has-[.card-link:focus-visible]:outline-offset-2 has-[.card-link:focus-visible]:outline-accent">
                  <a
                    href={topic.url}
                    class="card-link block font-medium text-ink group-hover:text-accent after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none"
                  >
                    <I18nTitle topic={topic.id} en={topic.title} />
                  </a>
                  <span class="mt-1 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-sm text-muted">
                    <T
                      k="{n} questions · {reviewed} reviewed"
                      one="{n} question · {reviewed} reviewed"
                      n={total}
                      params={{ reviewed: topic.reviewed }}
                    />
                    {test > 0 && (
                      <a
                        href={topicExamUrl(topic.id)}
                        class="relative z-10 -my-1 rounded-md px-1.5 py-1 font-medium text-accent underline-offset-2 hover:underline"
                      >
                        <T k="Test · {n} min" n={test} /><span class="sr-only"> <T k="on {title}" params={{ title }} /></span>
                      </a>
                    )}
                  </span>
                  <span
                    class="mt-2 hidden items-center gap-2 text-xs text-muted"
                    data-topic-progress
                    data-ids={topic.questionIds.join(" ")}
                  >
                    <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-subtle">
                      <span class="block h-full rounded-full bg-accent" data-bar style="width: 0%"></span>
                    </span>
                    <span class="tabular-nums" data-label></span>
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { initTopicProgress } from "../lib/topic-progress";

  initTopicProgress();
</script>
