---
import Base from "../layouts/Base.astro";
import { getBank } from "../lib/bank";
import { url } from "../lib/url";

const bank = await getBank();
const totalQuestions = bank.questions.length;
const totalReviewed = bank.questions.filter((q) => q.question.status === "reviewed").length;
const activeTopics = [...bank.topics.values()].filter((t) => t.questionIds.length > 0).length;
---

<Base wide>
  <section class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Practice AI, ML and deep learning by recalling, not rereading.</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Exam-style questions with instant feedback, worked explanations and cited sources. Pick a
      topic and answer one question at a time — your last result per question stays in this
      browser.
    </p>
    <p class="mt-4 text-sm text-muted">
      {totalQuestions} questions · {activeTopics} topics · {totalReviewed} reviewed ·
      <a href={url("tags/")} class="text-accent underline underline-offset-2">browse by tag</a>
    </p>
  </section>

  <div class="mt-10 space-y-10">
    {
      bank.domains.map((domain) => (
        <section aria-labelledby={`domain-${domain.id}`}>
          <h2 id={`domain-${domain.id}`} class="text-sm font-semibold tracking-wide text-muted uppercase">
            {domain.title}
          </h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {domain.topics.map((topic) => {
              const total = topic.questionIds.length;
              if (total === 0) {
                return (
                  <li class="rounded-xl border border-dashed border-line px-4 py-3 text-muted">
                    <span class="font-medium">{topic.title}</span>
                    <span class="mt-1 block text-sm">No questions yet</span>
                  </li>
                );
              }
              return (
                <li>
                  <a
                    href={topic.url}
                    class="group block h-full rounded-xl border border-line bg-surface px-4 py-3 shadow-xs transition-colors hover:border-line-strong hover:bg-subtle"
                  >
                    <span class="flex items-start justify-between gap-3">
                      <span class="font-medium text-ink group-hover:text-accent">{topic.title}</span>
                      <span class="shrink-0 text-sm text-muted tabular-nums">{total}</span>
                    </span>
                    <span class="mt-1 block text-sm text-muted">
                      {total} {total === 1 ? "question" : "questions"} · {topic.reviewed} reviewed
                    </span>
                    <span
                      class="mt-2 hidden items-center gap-2 text-xs text-muted"
                      data-topic-progress
                      data-ids={topic.questionIds.join(" ")}
                    >
                      <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-subtle">
                        <span class="block h-full rounded-full bg-accent" data-bar style="width: 0%"></span>
                      </span>
                      <span class="tabular-nums" data-label></span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { loadResults, summarize } from "../lib/storage";

  // Fill in "answered / total" per topic from this browser's stored results.
  const results = loadResults();
  for (const el of document.querySelectorAll<HTMLElement>("[data-topic-progress]")) {
    const ids = (el.dataset.ids ?? "").split(" ").filter(Boolean);
    const { answered, correct } = summarize(results, ids);
    if (answered === 0) continue;
    const label = el.querySelector<HTMLElement>("[data-label]");
    const bar = el.querySelector<HTMLElement>("[data-bar]");
    if (label) label.textContent = `${answered} / ${ids.length} answered · ${correct} correct`;
    if (bar) bar.style.width = `${Math.round((answered / ids.length) * 100)}%`;
    el.classList.replace("hidden", "flex");
  }
</script>
