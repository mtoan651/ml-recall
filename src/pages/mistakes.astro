---
import Mistakes from "../components/Mistakes";
import T from "../components/T.astro";
import Base from "../layouts/Base.astro";
import { getBank, toCatalog } from "../lib/bank";

const catalog = toCatalog(await getBank());
---

<Base
  titleKey="My mistakes"
  description="Practice again the questions you answered wrong, until you get them right."
>
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl"><T k="My mistakes" /></h1>
  <p class="mt-2 text-muted"><T k="Kept in this browser, like the rest of your progress." /></p>
  <noscript>
    <p class="mt-4 text-muted">This page needs JavaScript.</p>
  </noscript>
  <div class="mt-6">
    <Mistakes client:load catalog={catalog} />
  </div>
</Base>
