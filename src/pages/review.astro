---
import Review from "../components/Review";
import Base from "../layouts/Base.astro";
import { getBank, toCatalog } from "../lib/bank";

const catalog = toCatalog(await getBank());
---

<Base
  title="Review"
  description="Spaced repetition: the questions due today, scheduled with FSRS from your past answers."
>
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Review</h1>
  <p class="mt-2 text-muted">Kept in this browser, like the rest of your progress.</p>
  <noscript>
    <p class="mt-4 text-muted">This page needs JavaScript.</p>
  </noscript>
  <div class="mt-6">
    <Review client:load catalog={catalog} />
  </div>
</Base>
