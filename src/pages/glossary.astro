---
/**
 * English–Vietnamese glossary (src/content/glossary.yaml, generated by `mlr glossary` from the
 * d2l-vi glossary, CC BY-SA 4.0). A filter box matches either language, ignoring accents.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";

const terms = (await getCollection("glossary"))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);
const letterOf = (en: string) =>
  en
    .replace(/^\([^)]*\)\s*/, "")
    .charAt(0)
    .toUpperCase();
const groups = new Map<string, typeof terms>();
for (const t of terms) groups.set(letterOf(t.en), [...(groups.get(letterOf(t.en)) ?? []), t]);
---

<Base
  title="Glossary"
  description={`${terms.length} machine-learning terms in English and Vietnamese, from the Vietnamese edition of Dive into Deep Learning.`}
>
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Glossary</h1>
  <p class="mt-2 text-muted">
    {terms.length} terms in English and Vietnamese (Thuật ngữ Anh – Việt), from the glossary of
    <a href="https://github.com/d2l-ai/d2l-vi" class="text-accent underline underline-offset-2" rel="noopener">Đắm mình vào Học Sâu</a>,
    the Vietnamese edition of Dive into Deep Learning (CC BY-SA 4.0).
  </p>
  <label class="mt-5 block max-w-md">
    <span class="sr-only">Filter terms</span>
    <input id="glossary-filter" type="search" placeholder="Filter: softmax, hàm mất mát…" autocomplete="off"
      class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm placeholder:text-muted" />
  </label>
  <p id="glossary-count" class="mt-2 text-sm text-muted" aria-live="polite"></p>
  <nav aria-label="Letters" class="mt-4 flex flex-wrap gap-1 text-sm">
    {[...groups.keys()].map((letter) => <a href={`#g-${letter}`} class="rounded px-1.5 py-0.5 text-accent hover:bg-subtle">{letter}</a>)}
  </nav>
  <div class="mt-4 space-y-6">
    {
      [...groups.entries()].map(([letter, list]) => (
        <section aria-labelledby={`g-${letter}`} data-group>
          <h2 id={`g-${letter}`} class="scroll-mt-4 text-sm font-semibold tracking-wide text-muted uppercase">{letter}</h2>
          <dl class="mt-2 divide-y divide-line rounded-xl border border-line bg-surface">
            {list.map((t) => (
              <div class="grid gap-x-4 px-3.5 py-2 sm:grid-cols-2" data-term>
                <dt lang="en" class="font-medium">{t.en}</dt>
                <dd lang="vi" class="text-muted sm:text-ink">{t.vi}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
  <p class="mt-8 text-sm text-muted">
    Source: <code>glossary.md</code> of d2l-ai/d2l-vi, pinned commit; see
    <a href={url("search/")} class="text-accent underline underline-offset-2">Search</a> to find questions using a term.
  </p>
  <script>
    const fold = (s: string) =>
      s.normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d").replace(/Đ/g, "D").toLowerCase();
    const input = document.getElementById("glossary-filter") as HTMLInputElement | null;
    const count = document.getElementById("glossary-count");
    const rows = [...document.querySelectorAll<HTMLElement>("[data-term]")].map((el) => ({
      el,
      text: fold(el.textContent ?? ""),
    }));
    function apply() {
      const q = fold(input?.value.trim() ?? "");
      let shown = 0;
      for (const r of rows) {
        const hit = q === "" || r.text.includes(q);
        r.el.hidden = !hit;
        if (hit) shown++;
      }
      for (const g of document.querySelectorAll<HTMLElement>("[data-group]")) {
        g.hidden = !g.querySelector("[data-term]:not([hidden])");
      }
      if (count) count.textContent = q ? `${shown} of ${rows.length} terms` : "";
    }
    input?.addEventListener("input", apply);
  </script>
</Base>
