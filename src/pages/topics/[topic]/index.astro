---
import ExamCallout from "../../../components/ExamCallout.astro";
import I18nTitle from "../../../components/I18nTitle.astro";
import Quiz from "../../../components/Quiz";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { getBank, toQuizQuestions } from "../../../lib/bank";
import { getNotes } from "../../../lib/notes";
import { topicExamUrl, url } from "../../../lib/url";

export async function getStaticPaths() {
  const bank = await getBank();
  return [...bank.topics.values()]
    .filter((topic) => topic.questionIds.length > 0)
    .map((topic) => ({ params: { topic: topic.id } }));
}

const bank = await getBank();
const topic = bank.topics.get(Astro.params.topic);
if (!topic) throw new Error(`Unknown topic ${Astro.params.topic}`);
const topicQuestions = bank.questions.filter((q) => q.topic.id === topic.id);
const questions = await toQuizQuestions(topicQuestions, bank);
const total = questions.length;
const note = (await getNotes(bank)).get(topic.id);
---

<Base
  titleKey="{title}"
  titleParams={{ title: { topic: topic.id, en: topic.title } }}
  description={`${total} practice questions on ${topic.title} (${topic.domainTitle}) with instant feedback and cited explanations.`}
>
  <nav aria-label="Breadcrumb" data-i18n="Breadcrumb" data-i18n-attr="aria-label" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink"><T k="Topics" /></a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <span><I18nTitle domain={topic.domainId} en={topic.domainTitle} /></span>
  </nav>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
    <I18nTitle topic={topic.id} en={topic.title} />
  </h1>
  {topic.description && <p class="mt-2 text-muted" lang="en">{topic.description}</p>}
  <p class="mt-2 text-sm text-muted">
    <T
      k="{n} questions · {reviewed} reviewed"
      one="{n} question · {reviewed} reviewed"
      n={total}
      params={{ reviewed: topic.reviewed }}
    />
    {
      note && (
        <>
          {" · "}
          <a href={`${topic.url}notes/`} class="font-medium text-accent hover:underline">
            <T k="Read the notes ({n} min)" n={note.minutes} />
          </a>
        </>
      )
    }
  </p>

  <ExamCallout
    kind="topic"
    id={topic.id}
    href={topicExamUrl(topic.id)}
    available={topicQuestions.length}
  />

  <div class="mt-6">
    <Quiz client:load questions={questions} scope={{ topic: topic.id, en: topic.title }} />
  </div>
</Base>
