---
import MixedExam from "../components/MixedExam";
import Base from "../layouts/Base.astro";
import { getBank, toCatalog } from "../lib/bank";
import { url } from "../lib/url";

// The page embeds only the question index; the drawn questions are fetched from data/q/.
const catalog = toCatalog(await getBank());
---

<Base
  title="Mixed test"
  description="Timed test across the topics and difficulties you choose: up to 50 random questions, one minute each, scored and explained at the end."
>
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink">Topics</a>
  </nav>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Mixed test</h1>
  <noscript>
    <p class="mt-4 text-muted">The timed test needs JavaScript.</p>
  </noscript>
  <div class="mt-6">
    <MixedExam client:load catalog={catalog} />
  </div>
</Base>
