---
import T from "../components/T.astro";
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---

<Base titleKey="Not found">
  <h1 class="text-2xl font-semibold tracking-tight"><T k="Page not found" /></h1>
  <p class="mt-3 text-muted">
    <T k="This page does not exist (anymore)." />
    <a href={url()} class="text-accent underline underline-offset-2"><T k="Back to all topics" /></a>.
  </p>
</Base>
