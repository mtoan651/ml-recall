---
import Exam from "../../../components/Exam";
import Base from "../../../layouts/Base.astro";
import { examQuestions, getBank, toQuizQuestions } from "../../../lib/bank";
import { planExam } from "../../../lib/exam";
import { tagUrl, url } from "../../../lib/url";

// One test page per tag with at least one auto-gradable question.
export async function getStaticPaths() {
  const bank = await getBank();
  return [...bank.tags.entries()]
    .filter(([, tagged]) => examQuestions(tagged).length > 0)
    .map(([tag]) => ({ params: { tag } }));
}

const bank = await getBank();
const tag = Astro.params.tag;
const tagged = bank.tags.get(tag) ?? [];
const eligible = examQuestions(tagged);
// Only the questions a test can draw from are embedded in the page.
const questions = await toQuizQuestions(eligible, bank);
const { count } = planExam(questions.length);
---

<Base
  title={`Test: #${tag}`}
  description={`Timed test on questions tagged ${tag}: ${count} random ${count === 1 ? "question" : "questions"} in ${count} ${count === 1 ? "minute" : "minutes"}, scored and explained at the end.`}
>
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink">Topics</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={url("tags/")} class="hover:text-ink">Tags</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={tagUrl(tag)} class="hover:text-ink">#{tag}</a>
  </nav>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Test: #{tag}</h1>
  <noscript>
    <p class="mt-4 text-muted">The timed test needs JavaScript.</p>
  </noscript>

  <div class="mt-6">
    <Exam
      client:load
      questions={questions}
      scope={{ kind: "tag", id: tag, title: `#${tag}`, practiceUrl: tagUrl(tag) }}
      excluded={tagged.length - eligible.length}
      showTopic
    />
  </div>
</Base>
