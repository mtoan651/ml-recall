---
import ExamCallout from "../../../components/ExamCallout.astro";
import I18nTitle from "../../../components/I18nTitle.astro";
import Quiz from "../../../components/Quiz";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { getBank, toQuizQuestions } from "../../../lib/bank";
import { EXAM_MAX_QUESTIONS } from "../../../lib/exam";
import { mixedExamUrl, tagExamUrl, url } from "../../../lib/url";

export async function getStaticPaths() {
  const bank = await getBank();
  return [...bank.tags.keys()].map((tag) => ({ params: { tag } }));
}

const bank = await getBank();
const tag = Astro.params.tag;
const tagged = bank.tags.get(tag) ?? [];
const questions = await toQuizQuestions(tagged, bank);
const topics = [...new Map(tagged.map((q) => [q.topic.id, q.topic])).values()];
const total = questions.length;
---

<Base title={`#${tag}`} description={`${total} practice questions tagged ${tag}.`}>
  <nav aria-label="Breadcrumb" data-i18n="Breadcrumb" data-i18n-attr="aria-label" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink"><T k="Topics" /></a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={url("tags/")} class="hover:text-ink"><T k="Tags" /></a>
  </nav>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">#{tag}</h1>
  <p class="mt-2 text-sm text-muted">
    <T k="{n} questions from" one="{n} question from" n={total} />
    {/* one line per item: whitespace between the link and the comma would render as a space */}
    {
      topics.map((t, i) => (
        <>{i > 0 && ", "}<a href={t.url} class="underline underline-offset-2 hover:text-ink"><I18nTitle topic={t.id} en={t.title} /></a></>
      ))
    }
  </p>

  <ExamCallout kind="tag" id={tag} href={tagExamUrl(tag)} available={tagged.length}>
    {
      tagged.length > EXAM_MAX_QUESTIONS && (
        <p class="mt-1 text-sm">
          <a
            href={mixedExamUrl(tag)}
            class="text-accent underline-offset-2 hover:underline"
          >
            <T k="Longer test or by difficulty: mixed test with {tag}" params={{ tag: `#${tag}` }} />
          </a>
        </p>
      )
    }
  </ExamCallout>

  <div class="mt-6">
    <Quiz client:load questions={questions} scope={`#${tag}`} showTopic />
  </div>
</Base>
