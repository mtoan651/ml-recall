---
import T from "../../components/T.astro";
import Base from "../../layouts/Base.astro";
import { getBank } from "../../lib/bank";
import { tagUrl, url } from "../../lib/url";

const bank = await getBank();
const tags = [...bank.tags.entries()].map(([tag, questions]) => ({ tag, count: questions.length }));
---

<Base titleKey="Tags" description="Practice questions grouped by tag.">
  <nav aria-label="Breadcrumb" data-i18n="Breadcrumb" data-i18n-attr="aria-label" class="text-sm text-muted">
    <a href={url()} class="hover:text-ink"><T k="Topics" /></a>
  </nav>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"><T k="Tags" /></h1>
  <p class="mt-2 text-muted"><T k="Cross-topic practice sets: every question carrying a tag, in one session." /></p>

  {
    tags.length === 0 ? (
      <p class="mt-8 text-muted"><T k="No tagged questions yet." /></p>
    ) : (
      <ul class="mt-6 flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <li>
            <a
              href={tagUrl(tag)}
              class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-sm hover:border-line-strong hover:bg-subtle"
            >
              <span>#{tag}</span>
              <span class="text-muted tabular-nums">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
