---
/**
 * Shown by the service worker when a page that was never opened is requested offline. Lists
 * the pages this browser keeps (the service worker's page cache), with their titles.
 */
import T from "../components/T.astro";
import Base from "../layouts/Base.astro";
import { getBank } from "../lib/bank";
import { url } from "../lib/url";

const bank = await getBank();
// Topic URLs → [id, title], so kept topic pages are listed by name.
const titles = Object.fromEntries(
  bank.domains.flatMap((d) => d.topics.map((t) => [t.url, [t.id, t.title]])),
);
---

<Base titleKey="Offline" description="You are offline; these pages are kept in this browser.">
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl"><T k="You're offline" /></h1>
  <p class="mt-2 text-muted">
    <T k="This page hasn't been saved in this browser yet. Pages you opened before still work offline, and so do Review, Mistakes and Progress — your answers are saved as usual." />
  </p>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href={url()} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:bg-accent-hover"><T k="Topics" /></a>
    <a href={url("review/")} class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle"><T k="Review" /></a>
    <a href={url("mistakes/")} class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium hover:bg-subtle"><T k="My mistakes" /></a>
  </div>
  <section aria-labelledby="kept-heading" class="mt-8">
    <h2 id="kept-heading" class="font-semibold"><T k="Available offline" /></h2>
    <ul id="kept" class="mt-3 space-y-1 text-sm" data-titles={JSON.stringify(titles)}></ul>
    <p id="kept-none" class="mt-3 text-sm text-muted" hidden>
      <T k="No topic pages kept yet: open a topic while online to practise it offline later." />
    </p>
  </section>
  <script>
    import { currentLang, LANG_EVENT, t, titleOf } from "../lib/i18n";

    const list = document.getElementById("kept");
    const titles: Record<string, [string, string]> = JSON.parse(list?.dataset.titles ?? "{}");
    let paths: string[] = [];

    function render() {
      if (!list) return;
      const lang = currentLang();
      list.replaceChildren(
        ...paths.map((path) => {
          const item = document.createElement("li");
          const link = document.createElement("a");
          const topic = titles[path];
          link.href = path;
          link.className = "inline-block text-accent hover:underline pointer-coarse:py-1";
          link.textContent = topic
            ? titleOf(lang, { topic: topic[0], en: topic[1] })
            : t(lang, "Question {id}", { id: path.split("/").at(-2) ?? "" });
          item.append(link);
          return item;
        }),
      );
      document.getElementById("kept-none")?.toggleAttribute("hidden", paths.length > 0);
    }

    async function show() {
      if (!list || !("caches" in window)) return;
      const cache = await caches.open("ml-recall-pages-v1");
      paths = (await cache.keys())
        .map((request) => new URL(request.url).pathname)
        .filter((path) => titles[path] || /\/q\/[^/]+\/$/.test(path))
        .sort();
      render();
    }
    show();
    window.addEventListener(LANG_EVENT, render);
  </script>
</Base>
